#!/bin/sh
# MindAttic commit rule: every commit's subject ends with an existing ticket ID, e.g. "... (M.ORCH-T12)".
subject=$(sed 's/\r$//' "$1" | grep -v '^#' | sed '/^[[:space:]]*$/d' | head -n 1)

case "$subject" in
  "Merge "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# A trailing quote is allowed so git revert's default 'Revert "... (ID)"' passes.
id=$(printf '%s\n' "$subject" | sed -n 's/.*(\([A-Z][A-Z0-9]*\(\.[A-Z0-9][A-Z0-9]*\)*-T[0-9][0-9]*\))"\{0,1\}[[:space:]]*$/\1/p')

if [ -z "$id" ]; then
  cat >&2 <<'EOF'
commit refused: the subject line must end with its ticket ID in parentheses, e.g. "... (M.ORCH-T12)".
No ticket yet? Create one first: tickets ticket new --type feature|fix|chore|docs --summary "..." (it prints the ID).
One ticket per commit: stage only that ticket's files and hunks.
EOF
  exit 1
fi

# The CLI is `tickets` (MindAttic.Tickets); `workflow` is its name from before the rename (M.TIX-T120).
cli=tickets
command -v tickets >/dev/null 2>&1 || cli=workflow
if ! command -v "$cli" >/dev/null 2>&1; then
  echo "commit refused: the tickets CLI isn't on PATH, so ticket $id can't be checked." >&2
  exit 1
fi

if ! "$cli" ticket show "$id" >/dev/null 2>&1; then
  echo "commit refused: ticket $id isn't in the ticket database. Check the ID (tickets ticket list) or create the ticket first (tickets ticket new)." >&2
  exit 1
fi
