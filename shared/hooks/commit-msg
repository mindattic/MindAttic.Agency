#!/bin/sh
# MindAttic commit rule: every commit's subject ends with an existing workflow ticket ID, e.g. "... (M.ORCH-T12)".
subject=$(sed 's/\r$//' "$1" | grep -v '^#' | sed '/^[[:space:]]*$/d' | head -n 1)

case "$subject" in
  "Merge "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# A trailing quote is allowed so git revert's default 'Revert "... (ID)"' passes.
id=$(printf '%s\n' "$subject" | sed -n 's/.*(\([A-Z][A-Z0-9]*\(\.[A-Z0-9][A-Z0-9]*\)*-T[0-9][0-9]*\))"\{0,1\}[[:space:]]*$/\1/p')

if [ -z "$id" ]; then
  cat >&2 <<'EOF'
commit refused: the subject line must end with its workflow ticket ID in parentheses, e.g. "... (M.ORCH-T12)".
No ticket yet? Create one first: workflow ticket new --type feature|fix|chore|docs --summary "..." (it prints the ID).
One ticket per commit: stage only that ticket's files and hunks.
EOF
  exit 1
fi

if ! command -v workflow >/dev/null 2>&1; then
  echo "commit refused: the workflow CLI isn't on PATH, so ticket $id can't be checked." >&2
  exit 1
fi

if ! workflow ticket show "$id" >/dev/null 2>&1; then
  echo "commit refused: ticket $id isn't in the workflow database. Check the ID (workflow ticket list) or create the ticket first (workflow ticket new)." >&2
  exit 1
fi
